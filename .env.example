# Run python scripts/init_local.py to generate private local keys and a database password.
# Never commit .env or put production credentials in this example.
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback/
PRIVACY_NOTICE=
# For HTTPS deployment, also set HTTPS=1 and CSRF_TRUSTED_ORIGINS=https://your-domain.
